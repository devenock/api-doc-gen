# Build output
bin/
dist/
apidoc-gen
api-doc-gen
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage
*.test
*.out
coverage.html
coverage.txt

# Local config (optional; remove if you want to track .apidoc-gen.yaml)
# .apidoc-gen.yaml

# Postman upload cache (collection title -> UID); safe to delete locally
.apidoc-gen-cache.json

# Generated docs (when testing locally)
docs-out/
docs-q/
docs/*.json
docs/*.yaml
docs/*.html

# examples/ecommerce-gin, blog-chi, and crm-gorilla are small, purpose-built
# fixture APIs tracked in the repo (see examples/README.md). Generated output
# from running api-doc-gen against them is not.
examples/*/docs/
# angamarket_backend is a separate, real project (its own git remote) kept
# here only for ad hoc local testing against a large real-world codebase -
# never meant to be published as part of this repo.
examples/angamarket_backend/

# IDE and OS
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Go workspace
go.work
go.work.sum
